<!-- Auth block: email / password + social login -->
<div id="authWidget" class="p-4">
  <label class="block text-xs text-slate-400 mb-1">Email (mintaqaviy):</label>
  <input id="regionEmail" type="email" placeholder="user@domain.uz yoki user@domain.kg" class="w-full p-2 rounded" />
  <label class="block text-xs text-slate-400 mt-2 mb-1">Parol:</label>
  <input id="regionPassword" type="password" placeholder="Parolingiz" class="w-full p-2 rounded" />

  <div class="mt-3 flex gap-2">
    <button onclick="localLogin()" class="px-4 py-2 bg-indigo-600 text-white rounded">Kirish</button>
    <button onclick="openRegister()" class="px-4 py-2 bg-slate-700 text-white rounded">Roʻyxatdan oʻtish</button>
  </div>

  <div class="mt-4">
    <p class="text-xs text-slate-400 mb-2">Ijtimoiy tarmoqlar bilan kirish:</p>
    <div class="flex gap-2">
      <a href="/auth/google" class="px-3 py-2 bg-white text-black rounded flex items-center gap-2"><i class="fab fa-google"></i> Google</a>
      <a href="/auth/facebook" class="px-3 py-2 bg-blue-700 text-white rounded flex items-center gap-2"><i class="fab fa-facebook-f"></i> Facebook</a>
      <a href="/auth/telegram" class="px-3 py-2 bg-cyan-600 text-white rounded flex items-center gap-2"><i class="fab fa-telegram-plane"></i> Telegram</a>
      <a href="/auth/instagram" class="px-3 py-2 bg-pink-500 text-white rounded flex items-center gap-2"><i class="fab fa-instagram"></i> Instagram</a>
      <a href="/auth/youtube" class="px-3 py-2 bg-red-600 text-white rounded flex items-center gap-2"><i class="fab fa-youtube"></i> YouTube</a>
    </div>
  </div>
</div>

<script>
  async function localLogin() {
    const email = document.getElementById('regionEmail').value.trim();
    const password = document.getElementById('regionPassword').value;
    if (!email || !password) { alert('Email va parol kiriting'); return; }

    // client-side regional validation (qoida): ruxsat etilgan TLDlar misol
    const allowedTLD = ['uz','kg','tj','kz','com','net','org'];
    const tld = (email.split('.').pop() || '').toLowerCase();
    if (!allowedTLD.includes(tld)) {
      // bu yerda siz qaysi mintaqa uchun ruxsat berishni sozlaysiz
      if (!confirm('Siz kiritgan domen mintaqaviy emas — davom etilsinmi?')) return;
    }

    const res = await fetch('/api/auth/local', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    const json = await res.json();
    if (res.ok) {
      // server JWT yoki redirect qaytaradi
      localStorage.setItem('token', json.token);
      alert('Kirish muvaffaqiyatli');
      location.reload();
    } else {
      alert(json.message || 'Kirish xatosi');
    }
  }
</script>
